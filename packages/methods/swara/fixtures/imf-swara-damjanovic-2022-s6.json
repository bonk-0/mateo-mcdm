      {
        "id": "DP",
        "name": "Number of dead persons"
      },
      {
        "id": "IP",
        "name": "Number of injured persons"
      },
      {
        "id": "NRV",
        "name": "Number of registered vehicles"
      },
      {
        "id": "PASSLOCAL",
        "name": "Passengers in local road transport"
      }
    ],
    "criteriaOrder": "descending significance, as ranked by the experts",
    "scale": [
      {
        "abbreviation": "ALS",
        "term": "Absolutely less significant",
        "tfn": [1, 1, 1]
      },
      {
        "abbreviation": "DLS",
        "term": "Dominantly less significant",
        "tfn": [0.5, 0.6666666666666666, 1]
      },
      {
        "abbreviation": "MLS",
        "term": "Much less significant",
        "tfn": [0.4, 0.5, 0.6666666666666666]
      },
      {
        "abbreviation": "RLS",
        "term": "Really less significant",
        "tfn": [0.3333333333333333, 0.4, 0.5]
      },
      {
        "abbreviation": "LS",
        "term": "Less significant",
        "tfn": [0.2857142857142857, 0.3333333333333333, 0.4]
      },
      {
        "abbreviation": "MDLS",
        "term": "Moderately less significant",
        "tfn": [0.25, 0.2857142857142857, 0.3333333333333333]
      },
      {
        "abbreviation": "WLS",
        "term": "Weakly less significant",
        "tfn": [0.2222222222222222, 0.25, 0.2857142857142857]
      },
      {
        "abbreviation": "ES",
        "term": "Equally significant",
        "tfn": [0, 0, 0]
      }
    ],
    "assessments": [null, "WLS", "WLS", "WLS"]
  },
  "parameters": {
    "defuzzification": "graded-mean"
  },
  "steps": {
    "coefficients": {
      "printedIn": "Table 4",
      "decimals": 2,
      "values": [
        [1, 1, 1],
        [1.22, 1.25, 1.29],
        [1.22, 1.25, 1.29],
        [1.22, 1.25, 1.29]
      ]
    },
    "recalculatedWeights": {
      "printedIn": "Table 4",
      "decimals": 2,
      "values": [
        [1, 1, 1],
        [0.78, 0.8, 0.82],
        [0.6, 0.64, 0.67],
        [0.47, 0.51, 0.55]
      ]
    },
    "recalculatedWeightsSum": {
      "printedIn": "Table 4, unlabelled sum row",
      "decimals": 2,
      "values": [2.85, 2.95, 3.03]
    },
    "fuzzyWeights": {
      "printedIn": "Table 4",
      "decimals": 2,
      "values": [
        [0.33, 0.34, 0.35],
        [0.26, 0.27, 0.29],
        [0.2, 0.22, 0.23],
        [0.15, 0.17, 0.19]
      ]
    }
  },
  "result": {
    "weights": {
      "printedIn": "Table 4, column 'crisp value'",
      "decimals": 2,
      "values": [0.34, 0.27, 0.22, 0.17]
    }
  },
  "deviations": [
    {
      "path": "steps.recalculatedWeightsSum.values[2]",
      "printed": 3.03,
      "recomputed": 3.0353,
      "note": "1 + 0.8182 + 0.6694 + 0.5477 = 3.0353; Table 4 prints 3.03 where rounding gives 3.04."
    },
    {
      "path": "steps.fuzzyWeights.values[3][0]",
      "printed": 0.15,
      "recomputed": 0.155,
      "note": "0.4705 / 3.0353 = 0.1550; Table 4 prints 0.15 where rounding gives 0.16."
