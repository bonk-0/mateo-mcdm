{
  "name": "@mateo/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Tauri desktop shell of Mateo.",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:ci": "tauri build --bundles deb",
    "icons": "tauri icon icons/source.png -o src-tauri/icons && rm -rf src-tauri/icons/android src-tauri/icons/ios",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4"
  }
}
